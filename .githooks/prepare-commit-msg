#!/bin/sh
# prepare-commit-msg — TEMPORARY pair-coauthor trailer helper.
#
# Appends `Co-authored-by:` trailers randomly selected from .coauthors
# (populated from mkr-infinity followers) AFTER the user's message, with
# a single blank line separator, at the very end of the commit message file.
#
# Behavior contract:
#   - acts ONLY for normal commits (skips merge / squash / rebase, and
#     does not meddle with --amend reuse commits either: it can only
#     append, never strip, so amend stays intact)
#   - idempotent: entries already present in the message are skipped
#   - selects a dynamic count (2 to 10) of distinct co-authors per commit
#   - silent no-op if .coauthors is missing/empty or has no usable lines
#   - always exits 0 — never blocks a commit
#
# Remove any time with:  bash scripts/setup-git.sh --uninstall
# (full removal path in SETUP-PAIR.md)

msg_file="$1"
source="${2:-}"

case "$source" in
  merge | squash | rebase | commit)
    # not a normal commit: do nothing at all
    exit 0
    ;;
  "" | message)
    # normal commit: continue below
    ;;
  *)
    # unknown source type: stay out of the way
    exit 0
    ;;
esac

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
coauthors_file="$root/.coauthors"
[ -f "$coauthors_file" ] || exit 0

# Count usable coauthor entries in file
total=$(grep -c '<.*>' "$coauthors_file" 2>/dev/null || echo 0)
[ "$total" -ge 1 ] || exit 0

# Dynamic coauthor count: randomly pick between 2 and 10 (or up to total available)
min=2
max=10
[ "$total" -lt "$max" ] && max="$total"
[ "$min" -gt "$max" ] && min="$max"

if command -v shuf >/dev/null 2>&1; then
  count=$(shuf -i "$min"-"$max" -n 1 2>/dev/null || echo "$min")
  selected=$(shuf -n "$count" "$coauthors_file" 2>/dev/null || cat "$coauthors_file")
else
  selected=$(cat "$coauthors_file")
fi

blank_written=
while IFS= read -r line || [ -n "$line" ]; do
  # trim surrounding whitespace and carriage returns
  line=$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  case "$line" in
    '' | '#'*) continue ;;
  esac
  # accept only plausible "Name <email>" author lines
  case "$line" in
    *'<'*'>'*) ;;
    *) continue ;;
  esac
  # idempotency: check if already in msg_file
  if grep -qF "Co-authored-by: $line" "$msg_file" 2>/dev/null; then
    continue
  fi
  if [ -z "$blank_written" ]; then
    # single blank-line separator before the trailer block
    printf '\n' >> "$msg_file"
    blank_written=1
  fi
  printf 'Co-authored-by: %s\n' "$line" >> "$msg_file"
done <<EOF
$selected
EOF

exit 0
