# ============================================================
# optimai-telegram-node - configuration
# Copy this file to .env and fill in the two REQUIRED values.
#   cp .env.example .env && nano .env
# NEVER commit the real .env to git (it is gitignored).
# ============================================================

# ---------- REQUIRED ----------

# Telegram bot token. Get it: open Telegram -> talk to @BotFather
# -> /newbot -> choose a name and username -> copy the token.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs (comma-separated) allowed to use this
# bot. Get yours: deploy once with this empty -> message your bot
# -> /id -> it replies with your numeric ID -> put it here.
# Example: TELEGRAM_ALLOWED_IDS=6602332612
TELEGRAM_ALLOWED_IDS=

# ---------- OPTIONAL (defaults shown) ----------

# Auto-start the node on boot when authenticated and desired-state
# is "running". true / false
NODE_AUTO_START=true

# Lines shown by /logs
LOG_TAIL_LINES=40

# /watch live-tail duration in seconds (per-call arg clamped 10-600)
WATCH_SECONDS=120

# Pending login session expiry in minutes
LOGIN_TTL_MINUTES=15

# Set (e.g. 8080) to serve GET /health -> 200 OK for platform
# healthchecks. Leave empty on a VPS. Railway worker needs none.
ENABLE_HEALTH_PORT=

# Timezone for logs. Example for India: Asia/Kolkata
TZ=UTC

# ---------- HOSTING-PROVIDER MODE (promo funnel) ----------

# Telegram username WITHOUT @ shown to unauthorized users.
CONTACT_USERNAME=mkr_infinity

# Full override of the unauthorized reply. Leave empty to use the
# built-in message. You may use the placeholder {contact}.
UNAUTHORIZED_MESSAGE=

# Total promo replies per unauthorized account, 0-10.
# 3 = they get the promo message 3 times ever (then silence).
# 0 = never reply to strangers. Survives bot restarts.
UNAUTH_MAX_MESSAGES=3

# ---------- INTERNAL (defaults are fine) ----------

# HOME used by the optimai CLI (credentials in $OPTIMAI_HOME/.optimai)
OPTIMAI_HOME=/data/home

# Bot state directory (state.json, unauth_counts.json, node.log)
DATA_DIR=/data/data

# Name/path of the optimai CLI binary (tests override this to a stub)
OPTIMAI_BIN=optimai-cli
